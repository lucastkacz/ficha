            "value" : "タイプ名の前に表示されます。なしにする場合は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유형 이름 앞에 표시됩니다. 이모지를 사용하지 않으려면 필드를 비워 두십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele aparece antes do nome do tipo. Deixe o campo vazio para não usar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно отображается перед названием типа. Оставьте поле пустым, чтобы обойтись без эмодзи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会显示在类型名称前。留空则不使用表情符号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
