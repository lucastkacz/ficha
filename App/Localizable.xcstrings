    "Separate tags with commas, and write “::” before a tag inside another, as in “economía::Argentina”." : {
      "comment" : "In the Cards window's card form, under the tags.\nIn the Cards window, under a card's tags, while Lucas edits it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne Schlagwörter mit Kommas und schreibe „::“ vor ein Schlagwort in einem anderen, wie in „economía::Argentina“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separá las etiquetas con comas, y escribí «::» antes de una etiqueta que va dentro de otra, como en «economía::Argentina»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparez les étiquettes par des virgules, et écrivez « :: » avant une étiquette contenue dans une autre, comme dans « economía::Argentina »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa le etichette con virgole, e scrivi “::” prima di un’etichetta dentro un’altra, come in “economía::Argentina”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe as etiquetas com vírgulas e escreva “::” antes de uma etiqueta dentro de outra, como em “economia::Brasil”."
          }
        }
      }
    },
