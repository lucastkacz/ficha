    "%@ · %lld front first, %lld back first" : {
      "comment" : "In the Cards window's detail, for a card that goes both ways: how many times Lucas reviewed it, either way, then how many of those went front first and back first, like “14 · 9 front first, 5 back first”. The first value is the number, and for VoiceOver the number with its noun, like “14 reviews”.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@، الجانب الأمامي أولًا: %2$lld، الجانب الخلفي أولًا: %3$lld"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · Vorderseite zuerst: %2$lld, Rückseite zuerst: %3$lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld front first, %3$lld back first"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · anverso primero: %2$lld, reverso primero: %3$lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · recto d’abord : %2$lld, verso d’abord : %3$lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · prima il fronte: %2$lld, prima il retro: %3$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · 表面から%2$lld回、裏面から%3$lld回"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · 앞면 먼저 %2$lld회, 뒷면 먼저 %3$lld회"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · frente primeiro: %2$lld, verso primeiro: %3$lld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · сначала лицо: %2$lld, сначала оборот: %3$lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · 正面在先%2$lld次，背面在先%3$lld次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
