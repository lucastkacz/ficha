            "state" : "translated",
            "value" : "선택한 덱의 카드만"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os cartões dos baralhos que você escolher"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только карточки из выбранных колод"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
