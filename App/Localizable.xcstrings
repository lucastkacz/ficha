    "Doesn't hold back appearances" : {
      "comment" : "The app's filter in a Focus, with its switch off.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Einblendungen nicht zurück"
