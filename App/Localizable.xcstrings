            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas tienen un lado con solo un sonido que Ficha no puede leer, como un archivo dañado."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjeta tiene un lado con solo un sonido que Ficha no puede leer, como un archivo dañado."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas tienen un lado con solo un sonido que Ficha no puede leer, como un archivo dañado."
                }
              }
            }
          }
        }
      }
    },
