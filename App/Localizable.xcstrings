    "No buried cards" : {
      "comment" : "In the Cards window: no card is buried.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine begrabenen Karten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay tarjetas enterradas"
          }
        },
        "fr" : {
