    "Write “::” between a deck and a deck inside it, as in “Idiomas::Inglés”." : {
      "comment" : "Under the title of the Cards window's sheet that names a new deck, after New Deck…, or of the Change Deck or Import sheet while it names one.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب \"::\" بين رزمة ورزمة داخلها، كما في \"Idiomas::Inglés\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe „::“ zwischen einen Stapel und einen Stapel darin, wie in „Idiomas::Inglés“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribí «::» entre un mazo y un mazo de adentro, como en «Idiomas::Inglés»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez « :: » entre un paquet et un paquet qu’il contient, comme dans « Idiomas::Inglés »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi “::” tra un mazzo e un mazzo al suo interno, come in “Idiomas::Inglés”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッキとその内側のデッキのあいだには「::」を書きます（例: 「Idiomas::Inglés」）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덱과 그 안의 덱 사이에 ‘::’을 쓰십시오(예: ‘Idiomas::Inglés’)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva “::” entre um baralho e um baralho dentro dele, como em “Idiomas::Inglês”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите «::» между колодой и вложенной в нее колодой, как в «Idiomas::Inglés»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在牌组与其中的牌组之间写“::”，例如“Idiomas::Inglés”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在牌組和其中的牌組之間寫上「::」，例如「Idiomas::Inglés」。"
          }
        }
      }
    },
    "Write “::” between a deck and a deck inside it, as in “Idiomas::Inglés”. The decks inside this one move with it, and a name another deck has joins the two." : {
      "comment" : "Under the title of the Cards window's sheet that renames a deck.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب \"::\" بين رزمة ورزمة داخلها، كما في \"Idiomas::Inglés\". تنتقل معها الرزم الموجودة داخل هذه الرزمة، وإذا كان الاسم لرزمة أخرى تُدمج الرزمتان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe „::“ zwischen einen Stapel und einen Stapel darin, wie in „Idiomas::Inglés“. Die Stapel darin werden mitbewegt, und ein Name, den schon ein anderer Stapel hat, führt beide zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribí «::» entre un mazo y un mazo de adentro, como en «Idiomas::Inglés». Los mazos de adentro de este se mueven con él, y un nombre que ya tiene otro mazo une los dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez « :: » entre un paquet et un paquet qu’il contient, comme dans « Idiomas::Inglés ». Les paquets qu’il contient se déplacent avec lui, et un nom déjà pris par un autre paquet fusionne les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi “::” tra un mazzo e un mazzo al suo interno, come in “Idiomas::Inglés”. I mazzi al suo interno si spostano con esso, e un nome che ha già un altro mazzo unisce i due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッキとその内側のデッキのあいだには「::」を書きます（例: 「Idiomas::Inglés」）。このデッキの内側のデッキも一緒に移動し、ほかのデッキと同じ名前にすると2つが統合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "덱과 그 안의 덱 사이에 ‘::’을 쓰십시오(예: ‘Idiomas::Inglés’). 이 덱 안의 덱도 함께 이동하며, 다른 덱이 이미 쓰는 이름을 입력하면 두 덱이 합쳐집니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva “::” entre um baralho e um baralho dentro dele, como em “Idiomas::Inglês”. Os baralhos dentro deste são movidos com ele, e um nome que outro baralho já tem junta os dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите «::» между колодой и вложенной в нее колодой, как в «Idiomas::Inglés». Вложенные колоды переместятся вместе с ней, а если такое название уже есть у другой колоды, они объединятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在牌组与其中的牌组之间写“::”，例如“Idiomas::Inglés”。此牌组中的牌组会随它一起移动，如果名称与另一个牌组相同，两者会合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在牌組和其中的牌組之間寫上「::」，例如「Idiomas::Inglés」。此牌組中的牌組會隨之移動；若使用其他牌組已有的名稱，兩者會合併。"
          }
        }
      }
    },
    "Write “::” between a tag and a tag inside it, as in “economía::Argentina”. The tags inside this one move with it, and a name another tag has joins the two." : {
      "comment" : "Under the title of the Cards window's sheet that renames a tag.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب \"::\" بين وسم ووسم داخله، كما في \"economía::Argentina\". تنتقل معه الوسوم الموجودة داخل هذا الوسم، وإذا كان الاسم لوسم آخر يُدمج الوسمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe „::“ zwischen ein Schlagwort und ein Schlagwort darin, wie in „economía::Argentina“. Die Schlagwörter darin werden mitbewegt, und ein Name, den schon ein anderes Schlagwort hat, führt beide zusammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribí «::» entre una etiqueta y una etiqueta de adentro, como en «economía::Argentina». Las etiquetas de adentro de esta se mueven con ella, y un nombre que ya tiene otra etiqueta une las dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez « :: » entre une étiquette et une étiquette qu’elle contient, comme dans « economía::Argentina ». Les étiquettes qu’elle contient se déplacent avec elle, et un nom déjà pris par une autre étiquette fusionne les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi “::” tra un’etichetta e un’etichetta al suo interno, come in “economía::Argentina”. Le etichette al suo interno si spostano con essa, e un nome che ha già un’altra etichetta unisce le due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグとその内側のタグのあいだには「::」を書きます（例: 「economía::Argentina」）。このタグの内側のタグも一緒に移動し、ほかのタグと同じ名前にすると2つが統合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그와 그 안의 태그 사이에 ‘::’을 쓰십시오(예: ‘economía::Argentina’). 이 태그 안의 태그도 함께 이동하며, 다른 태그가 이미 쓰는 이름을 입력하면 두 태그가 합쳐집니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva “::” entre uma etiqueta e uma etiqueta dentro dela, como em “economia::Brasil”. As etiquetas dentro desta são movidas com ela, e um nome que outra etiqueta já tem junta as duas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите «::» между меткой и вложенной в нее меткой, как в «economía::Argentina». Вложенные метки переместятся вместе с ней, а если такое название уже есть у другой метки, они объединятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签与其中的标签之间写“::”，例如“economía::Argentina”。此标签中的标签会随它一起移动，如果名称与另一个标签相同，两者会合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在標籤和其中的標籤之間寫上「::」，例如「economía::Argentina」。此標籤中的標籤會隨之移動；若使用其他標籤已有的名稱，兩者會合併。"
          }
        }
      }
    },
