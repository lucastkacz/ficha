          }
        }
      }
    },
    "Capture: “%@”\n\nExpand keeps yours next to it, so that refining takes both together. Ignore drops yours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التدوينة: \"%@\"\n\nيُبقي \"توسيع\" تدوينتك بجانبها، كي يتناولهما التنقيح معًا. ويتخلص \"تجاهل\" من تدوينتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfassung: „%@“\n\n„Erweitern“ behält deine daneben, damit beide zusammen ausgearbeitet werden. „Ignorieren“ verwirft deine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura: «%@»\n\nAmpliar guarda la tuya al lado, para que al refinar se tomen las dos juntas. Ignorar no guarda la tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture : « %@ »\n\nCompléter garde la vôtre à côté, pour que l’affinage les prenne ensemble. Ignorer supprime la vôtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cattura: “%@”\n\nAmplia tiene la tua accanto a essa, così vengono rifinite insieme. Ignora scarta la tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモ: 「%@」\n\n「補足にする」を選ぶと、入力したメモをこのメモの横に残し、仕上げのときに両方をまとめて扱います。「無視」を選ぶと、入力したメモは保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모: ‘%@’\n\n‘보충’은 사용자의 메모를 그 옆에 두어, 다듬을 때 둘을 함께 다룹니다. ‘무시’는 사용자의 메모를 버립니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura: “%@”\n\nAmpliar mantém a sua ao lado dela, para que o refinamento use as duas juntas. Ignorar descarta a sua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметка: «%@»\n\n«Дополнить» сохранит Вашу заметку рядом с ней, чтобы при доработке они учитывались вместе. «Игнорировать» отбросит Вашу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速记：“%@”\n\n“补充”会将你的速记保留在它旁边，以便完善时一并处理。“忽略”会丢弃你的速记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速記：「%@」\n\n「補充」會將你的速記保留在它旁邊，讓整理時一併處理兩者。「忽略」會捨棄你的速記。"
          }
        }
      }
    },
    "Captured" : {
