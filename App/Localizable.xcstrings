          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Karte hat eine Seite mit nur einem Ton, den Ficha nicht lesen kann, etwa eine beschädigte Datei."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Karten haben eine Seite mit nur einem Ton, den Ficha nicht lesen kann, etwa eine beschädigte Datei."
