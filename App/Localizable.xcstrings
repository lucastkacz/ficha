    },
    "To undo it, restore the copy saved before it, in Settings › Backups." : {
      "comment" : "In the Import sheet once it's done, when Ficha saved a copy before the import.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ihn rückgängig zu machen, stelle die davor gesicherte Kopie wieder her, in Einstellungen › Backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para deshacerla, restaurá la copia guardada antes, en Configuración › Respaldos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’annuler, restaurez la copie enregistrée juste avant, dans Réglages › Sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per annullarla, ripristina la copia salvata prima, in Impostazioni › Backup."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desfazer, restaure a cópia salva antes dela, em Ajustes › Backups."
          }
        }
      }
    },
    "Turn Off Both Ways" : {
