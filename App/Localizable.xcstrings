        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus tarjetas lo conservan, con su nuevo nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses cartes le gardent, avec son nouveau nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue carte lo mantengono, con il nuovo nome."
