            "value" : "Un libro, un podcast…"
          }
        }
      }
    },
    "A camera" : {
      "comment" : "A camera whose name the OS doesn't give, in Diagnostics.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kamera"
          }
        },
        "es" : {
