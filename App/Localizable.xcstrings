    },
    "It syncs with the ticked deck it sits inside." : {
      "comment" : "Settings, under Sync: the tooltip of a deck's checkbox, ticked and waiting, inside a ticked deck.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird mit dem angehakten Stapel synchronisiert, in dem er liegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza con el mazo tildado que lo contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se synchronise avec le paquet coché qui le contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sincronizza con il mazzo spuntato in cui si trova."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é sincronizado com o baralho marcado que o contém."
          }
        }
      }
    },
    "It waits in the inbox, out of your reviews, until it's fixed." : {
      "comment" : "Under the title of the Cards window's sheet that flags a card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wartet im Eingang, außerhalb deiner Wiederholungen, bis sie korrigiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera en la bandeja, fuera de tus repasos, hasta que se corrija."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle attend dans la boîte de réception, hors de vos révisions, jusqu’à ce qu’elle soit corrigée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attende nella casella in entrata, fuori dai tuoi ripassi, finché non viene corretta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele espera na caixa de entrada, fora das suas revisões, até ser corrigido."
          }
        }
      }
    },
    "Its cards keep it, with its new name." : {
      "comment" : "Under the title of the Cards window's sheet that renames a card type of the user's own.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Karten behalten ihn unter seinem neuen Namen."
          }
