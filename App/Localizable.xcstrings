    "macOS didn't let %@ start at login (%@). Try again, or add it in System Settings > General > Login Items." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS didn't let %1$@ start at login (%2$@). Try again, or add it in System Settings > General > Login Items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no dejó que %1$@ se abra al iniciar sesión (%2$@). Probá de nuevo, o agregala en Configuración del Sistema > General > Elementos de inicio."
          }
        }
      }
    },
    "macOS didn't stop %@ from starting at login (%@). Try again, or remove it in System Settings > General > Login Items." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS didn't stop %1$@ from starting at login (%2$@). Try again, or remove it in System Settings > General > Login Items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
