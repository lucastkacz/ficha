{
  "sourceLanguage" : "en",
  "strings" : {
    "—" : {
      "comment" : "In the Cards window's review log, in place of the seconds Lucas took, when nothing measured them."
    },
    "%@ · %@" : {
      "comment" : "An appearance log entry in Diagnostics: when it showed, or was held back, and what opened the review panel.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%lld)" : {
      "comment" : "An item of the Export sheet's menu: the cards with a tag, with the tag and how many.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld)"
          }
        }
      }
    },
    "%@ can't open your cards" : {

    },
    "%@ couldn't read these settings, as when they're edited by hand: %@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings." : {
      "comment" : "An alert at launch. The names are the settings' names in the app's preferences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't read these settings, as when they're edited by hand: %2$@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings."
          }
        }
      }
    },
    "%@ couldn't turn on its capture shortcut" : {

    },
    "%@ never does, so it doesn't get in the real Ficha's way." : {

    },
    "%@ shows you cards only while it's open. You can change this later in Settings." : {
      "comment" : "An alert at the app's first launch, under whether it opens at login. The name is the app's."
    },
    "%@, %lld due" : {
      "comment" : "The menu-bar icon, with the due count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld due"
          }
        }
      }
    },
    "%@, back first" : {
      "comment" : "For VoiceOver, a point of the Cards window's chart: what Lucas answered, in a first view or review that went back first, like “Know it, back first”."
    },
    "%lld · %@" : {
      "comment" : "In the Cards window: the card's step on the ladder, front first or back first, counted from 1, and how long it waits, like 4 · 5d.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld · %2$@"
          }
        }
      }
    },
