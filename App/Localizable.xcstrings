        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой копии Ficha нет инструкций для ИИ. Установите Ficha заново или прочитайте их в репозитории Ficha на GitHub, в файле docs/instructions-for-an-ai.md."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Ficha副本缺少给AI的说明。请重新安装Ficha，或在GitHub上Ficha的仓库中阅读docs/instructions-for-an-ai.md。"
