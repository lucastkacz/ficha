          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app que mantiene la pantalla encendida"
          }
        }
      }
    },
    "Another app already uses this shortcut. Pick another in Settings, or quit that app, or turn its shortcut off, and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App verwendet diesen Kurzbefehl bereits. Wähle in den Einstellungen einen anderen, beende diese App oder deaktiviere ihren Kurzbefehl und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
