          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es erscheint vor dem Namen des Typs. Lass das Feld leer, wenn du keins möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra antes del nombre del tipo. Dejá el campo vacío para ninguno."
          }
        },
        "fr" : {
