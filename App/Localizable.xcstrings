    "Saving fixes it, and it keeps its progress." : {
      "comment" : "In the Cards window, under Lucas's note on a flagged card, while he edits it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحفظ يُصلحها، وتحتفظ بتقدمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Sichern gilt sie als korrigiert und behält ihren Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardarla, se corrige y conserva su progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrer la corrige, et elle garde sa progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvando la correggi, e mantiene i suoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存すると修正済みになり、進捗はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하면 수정이 완료되며, 진도는 유지됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao salvar, ele fica corrigido e mantém seu progresso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сохранения она будет считаться исправленной и сохранит свой прогресс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
