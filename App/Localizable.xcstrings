    },
    "It syncs with the ticked deck it sits inside." : {
      "comment" : "Settings, under Sync: the tooltip of a deck's checkbox, ticked and waiting, inside a ticked deck.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird mit dem angehakten Stapel synchronisiert, in dem er liegt."
