    "%lld cards have this type. They keep everything else, with no type." : {
      "comment" : "Under the title of the Cards window's question before it deletes a card type of the user's own, with how many cards have it, buried ones too.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 card has this type. It keeps everything else, with no type."
                }
              },
              "other" : {
