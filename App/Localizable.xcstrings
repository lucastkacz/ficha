    "Until you empty the Trash, you can put back what you move there." : {
      "comment" : "Under the title of the Backups tab's question before it moves copies to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis du den Papierkorb entleerst, kannst du zurücklegen, was du dorthin bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que vacíes el basurero, podés sacar de ahí lo que transfieras."
          }
        }
      }
    },
    "Update them with Anki's back and tags, keeping their deck and progress" : {
      "comment" : "In the Import sheet, the choice that updates the cards an Anki package repeats.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Ankis Rückseite und Schlagwörtern aktualisieren, Stapel und Fortschritt behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizarlas con el reverso y las etiquetas de Anki, conservando su mazo y su progreso"
          }
        }
      }
    },
    "Update them with the file's back, tags, type and source, keeping their deck and progress" : {
      "comment" : "In the Import sheet, the choice that updates the cards the file repeats.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Rückseite, Schlagwörtern, Typ und Quelle der Datei aktualisieren, Stapel und Fortschritt behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizarlas con el reverso, las etiquetas, el tipo y la fuente del archivo, conservando su mazo y su progreso"
          }
        }
      }
    },
    "Version %@ (%@)" : {
      "comment" : "Settings' About tab: the release version, then the build number in parentheses.",
