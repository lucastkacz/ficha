    "Opens the review panel with the cards that are due, as the menu's Review now does." : {
      "comment" : "What the app's Review Now action does, in the Shortcuts app.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح لوحة المراجعة بالبطاقات المستحقة، كما يفعل عنصر \"المراجعة الآن\" في القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet das Wiederholungsfenster mit den fälligen Karten, wie „Jetzt wiederholen“ im Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el panel de repaso con las tarjetas pendientes, como lo hace Repasar ahora en el menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le panneau de révision avec les cartes à réviser, comme le fait Réviser maintenant dans le menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il pannello di ripasso con le carte in scadenza, come fa Ripassa ora nel menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューの「今すぐ復習」と同じように、期日を迎えたカードで復習パネルを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴의 ‘지금 복습’처럼 만기 카드와 함께 복습 패널을 엽니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o painel de revisão com os cartões a revisar, como faz Revisar agora no menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает панель повторения с карточками к повторению, как пункт меню «Повторить сейчас»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开复习面板并显示到期的卡片，与菜单中的“立即复习”相同。"
