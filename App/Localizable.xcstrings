    "Another app already uses this shortcut. Pick another in Settings, or quit that app, or turn its shortcut off, and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App verwendet diesen Kurzbefehl bereits. Wähle in den Einstellungen einen anderen, beende diese App oder deaktiviere ihren Kurzbefehl und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app ya usa este atajo. Elegí otro en Configuración, o salí de esa app, o desactivá su atajo, y probá de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise déjà ce raccourci. Choisissez-en un autre dans les réglages, quittez cette app ou désactivez son raccourci, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra app usa già questa abbreviazione. Scegline un’altra in Impostazioni, oppure esci da quell’app o disattiva la sua abbreviazione, e riprova."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app já usa este atalho. Escolha outro nos Ajustes, ou encerre esse app, ou desative o atalho dele, e tente novamente."
          }
        }
      }
    },
