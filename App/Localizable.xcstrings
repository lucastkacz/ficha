      }
    },
    "Card: “%@”\n\nExpand keeps your capture in the inbox, attached to that card, so that refining adds it to the card. Ignore drops it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة: \"%@\"\n\nيُبقي \"توسيع\" تدوينتك في صندوق الوارد، مرفقة بتلك البطاقة، كي يضيفها التنقيح إلى البطاقة. ويتخلص \"تجاهل\" منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte: „%@“\n\n„Erweitern“ behält deine Erfassung im Eingang, an diese Karte angehängt, damit sie beim Ausarbeiten zur Karte hinzukommt. „Ignorieren“ verwirft sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjeta: «%@»\n\nAmpliar deja tu captura en la bandeja, unida a esa tarjeta, para que al refinar se agregue a la tarjeta. Ignorar no la guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte : « %@ »\n\nCompléter garde votre capture dans la boîte de réception, attachée à cette carte, pour que l’affinage l’ajoute à la carte. Ignorer la supprime."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carta: “%@”\n\nAmplia tiene la tua cattura nella casella in entrata, collegata a quella carta, così la rifinitura la aggiunge alla carta. Ignora la scarta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード: 「%@」\n\n「補足にする」を選ぶと、メモをこのカードの補足としてインボックスに残し、仕上げのときにカードに追加します。「無視」を選ぶと、メモは保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드: ‘%@’\n\n‘보충’은 사용자의 메모를 그 카드에 연결해 수신함에 두어, 다듬을 때 카드에 추가되게 합니다. ‘무시’는 메모를 버립니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartão: “%@”\n\nAmpliar mantém sua captura na caixa de entrada, anexada a esse cartão, para que o refinamento a acrescente ao cartão. Ignorar a descarta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка: «%@»\n\n«Дополнить» оставит Вашу заметку во входящих, привязав ее к этой карточке, чтобы при доработке ее добавили к карточке. «Игнорировать» отбросит ее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片：“%@”\n\n“补充”会将你的速记保留在收件箱中并附加到该卡片，以便完善时将其添加到卡片中。“忽略”会丢弃它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片：「%@」\n\n「補充」會將你的速記保留在收件匣中並附加到該卡片，讓整理時將它加入卡片。「忽略」會捨棄你的速記。"
          }
        }
      }
    },
    "Cards" : {
      "comment" : "A column of the Cards window's All Tags: how many cards carry the tag, or a tag inside it.\nThe Cards window's title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
