    "iCloud is full" : {
      "comment" : "A menu item while iCloud is full, which opens Settings' Sync tab, where it says changes wait until there's room.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة تخزين iCloud ممتلئة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Speicher ist voll"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud está lleno"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage iCloud saturé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud è pieno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudの容量がいっぱいです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 저장 공간이 가득 참"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud está cheio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище iCloud заполнено"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud已满"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud已滿"
          }
        }
      }
    },
    "iCloud is full: your changes wait until you free up space" : {
      "comment" : "Settings, under Sync: iCloud refused what this Mac sent, for lack of room.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة تخزين iCloud ممتلئة: تنتظر تغييراتك إلى أن تُفرغ مساحة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Speicher ist voll: Deine Änderungen warten, bis du Speicherplatz freigibst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud está lleno: tus cambios esperan hasta que liberes espacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stockage iCloud saturé : vos modifications attendent que vous libériez de l’espace"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud è pieno: le tue modifiche aspettano finché non liberi spazio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudの容量がいっぱいです: 空き領域ができるまで、変更は送信待ちになります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 저장 공간이 가득 참: 공간을 확보할 때까지 변경 사항이 기다립니다"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud está cheio: suas alterações esperam até você liberar espaço"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище iCloud заполнено: изменения ждут, пока Вы не освободите место"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud已满：你的更改会等到你释放空间后再同步"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud已滿：你的更改會等到你釋放空間後再上傳"
          }
        }
      }
    },
