    },
    "It waits in the inbox, out of your reviews, until it's fixed." : {
      "comment" : "Under the title of the Cards window's sheet that flags a card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wartet im Eingang, außerhalb deiner Wiederholungen, bis sie korrigiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera en la bandeja, fuera de tus repasos, hasta que se corrija."
