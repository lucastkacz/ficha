    "%lld cards go too, with their review logs, here and on your other devices." : {
      "comment" : "In the Cards window's question before it deletes a deck: the cards in it and in the decks inside it, counted on this Mac.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch eine Karte wird gelöscht, mit ihrem Wiederholungsverlauf, hier und auf deinen anderen Geräten."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch %lld Karten werden gelöscht, mit ihren Wiederholungsverläufen, hier und auf deinen anderen Geräten."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit ihm wird hier keine Karte gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 card goes too, with its review log, here and on your other devices."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cards go too, with their review logs, here and on your other devices."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No card here goes with it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se va una tarjeta, con su historial de repasos, acá y en tus otros dispositivos."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se va ninguna tarjeta con él."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cartes sont aussi supprimées, avec leur historique des révisions, ici et sur vos autres appareils."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Une carte est aussi supprimée, avec son historique des révisions, ici et sur vos autres appareils."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cartes sont aussi supprimées, avec leur historique des révisions, ici et sur vos autres appareils."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Aucune carte d’ici n’est supprimée avec lui."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
