    "Holds back appearances while this Focus is on. Review now still works." : {
      "comment" : "What the app's filter in a Focus does, in System Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرجئ الظهور أثناء تشغيل هذا التركيز. وتظل \"المراجعة الآن\" متاحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Einblendungen zurück, solange dieser Fokus aktiv ist. „Jetzt wiederholen“ funktioniert weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frena las apariciones mientras este enfoque está activado. Repasar ahora sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retient les apparitions tant que ce mode de concentration est activé. Réviser maintenant fonctionne toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trattiene le apparizioni mentre questa full immersion è attiva. Ripassa ora funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この集中モードがオンのあいだは出現を控えます。「今すぐ復習」は引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 집중 모드가 켜져 있는 동안 등장을 보류합니다. ‘지금 복습’은 계속 사용할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa as aparições enquanto este Foco estiver ativado. Revisar agora continua disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задерживает появления, пока включен этот режим фокусирования. «Повторить сейчас» по-прежнему работает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此专注模式打开时延后出现。“立即复习”仍然可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此專注模式開啟時會暫緩出現。「立即複習」仍可使用。"
          }
        }
      }
    },
