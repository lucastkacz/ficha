          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные приложения %@ удалены из iCloud. Если включить синхронизацию, все Ваши карточки будут отправлены снова."
          }
        },
        "zh-Hans" : {
