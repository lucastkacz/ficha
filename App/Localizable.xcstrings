            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas tienen un lado sin texto, imagen ni sonido una vez que se dejan afuera las imágenes de la web."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjeta tiene un lado sin texto, imagen ni sonido una vez que se dejan afuera las imágenes de la web."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas tienen un lado sin texto, imagen ni sonido una vez que se dejan afuera las imágenes de la web."
                }
              }
            }
          }
        }
      }
    },
    "%lld cards have a side with only a sound Ficha can't read, such as a damaged file." : {
      "comment" : "In the Import sheet, the cards of an Anki package that make none, with how many.",
