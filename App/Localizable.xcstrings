    "What do you want to know?" : {
      "comment" : "The prompt of the field where the user writes a question about the card the review panel shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du wissen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué querés saber?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que voulez-vous savoir ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi sapere?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você quer saber?"
          }
        }
      }
    },
    "What needs fixing?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was muss korrigiert werden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué hay que corregir?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’est-ce qui doit être corrigé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa va corretto?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que precisa ser corrigido?"
          }
        }
      }
