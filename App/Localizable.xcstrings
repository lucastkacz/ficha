    "%lld cards go too, with their review logs, here and on your other devices." : {
      "comment" : "In the Cards window's question before it deletes a deck: the cards in it and in the decks inside it, counted on this Mac.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch eine Karte wird gelöscht, mit ihrem Wiederholungsverlauf, hier und auf deinen anderen Geräten."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch %lld Karten werden gelöscht, mit ihren Wiederholungsverläufen, hier und auf deinen anderen Geräten."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit ihm wird hier keine Karte gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 card goes too, with its review log, here and on your other devices."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cards go too, with their review logs, here and on your other devices."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No card here goes with it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se va una tarjeta, con su historial de repasos, acá y en tus otros dispositivos."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se va ninguna tarjeta con él."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vengono eliminate anche %lld carte, con la loro cronologia dei ripassi, qui e sugli altri tuoi dispositivi."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Viene eliminata anche una carta, con la sua cronologia dei ripassi, qui e sugli altri tuoi dispositivi."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vengono eliminate anche %lld carte, con la loro cronologia dei ripassi, qui e sugli altri tuoi dispositivi."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nessuna carta viene eliminata insieme al mazzo."
                }
              }
            }
          }
        }
      }
    },
    "%lld cards have a side with neither text, an image nor a sound once images on the web are left out." : {
