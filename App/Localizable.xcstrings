    "Line %lld has a quote inside a quoted field that isn't doubled." : {
      "comment" : "In the Import sheet, a line the file can't read.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي السطر %lld على علامة اقتباس غير مضاعفة داخل حقل بين علامتي اقتباس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld hat in einem Feld in Anführungszeichen ein Anführungszeichen, das nicht verdoppelt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea %lld tiene comillas dentro de un campo entre comillas que no están duplicadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %lld contient un guillemet non doublé dans un champ entre guillemets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riga %lld ha delle virgolette non raddoppiate dentro un campo tra virgolette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld行目: 引用符で囲まれたフィールド内の引用符が二重になっていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번째 줄: 따옴표로 묶인 필드 안의 따옴표가 두 번 쓰이지 않았습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha %lld tem aspas dentro de um campo entre aspas que não estão duplicadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В строке %lld внутри поля в кавычках есть неудвоенная кавычка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%lld行的带引号字段中有未双写的引号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%lld行在以引號括住的欄位中，有未重複寫兩次的引號。"
          }
        }
      }
    },
    "Line %lld has a side with only the image “%@”, which Ficha can't read as an image." : {
      "comment" : "In the Import sheet, a line of a zip's text file that makes no card, with an image's name.",
      "localizations" : {
