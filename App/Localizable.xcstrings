    },
    "Capture %lld doesn't expand a card. Approve it into cards, or discard it." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the app and the widget show. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura %lld no amplía ninguna tarjeta. Aprobala en tarjetas, o descartala."
          }
        }
      }
    },
    "Capture %lld isn't in the inbox: it was already approved or discarded, or it doesn't exist. Check what's in the inbox." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the app and the widget show. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
