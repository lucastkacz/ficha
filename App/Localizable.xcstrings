            "state" : "translated",
            "value" : "카드에는 뒷면이 필요합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cartão precisa de um verso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У карточки должен быть оборот."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片需要有背面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片需要有背面。"
          }
        }
      }
    },
    "A card needs a front." : {
      "comment" : "In the Cards window, under a card's front, when Lucas saves it blank.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج البطاقة إلى جانب أمامي."
          }
        },
        "de" : {
          "stringUnit" : {
