    "Line %lld has one column: a front with no back after it." : {
      "comment" : "In the Import sheet, a line the file can't read.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في السطر %lld عمود واحد: جانب أمامي بلا جانب خلفي بعده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld hat nur eine Spalte: eine Vorderseite ohne Rückseite danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea %lld tiene una sola columna: un anverso sin reverso después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %lld n’a qu’une colonne : un recto sans verso après lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riga %lld ha una sola colonna: un fronte senza un retro dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld行目は列が1つだけです: 表面のあとに裏面がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번째 줄에 열이 하나뿐입니다: 앞면 뒤에 뒷면이 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha %lld tem uma coluna: uma frente sem verso depois dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В строке %lld одна колонка: лицо без оборота после него."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%lld行只有一列：只有正面，后面没有背面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%lld行只有一欄：只有正面，後面沒有背面。"
          }
        }
      }
    },
    "Line %lld has the type “%@”, which isn't one of yours, and only a file that names its Type column in a #columns header makes new types." : {
      "comment" : "In the Import sheet, a line the file can't read, with the type it has, which names no card type the user has, in a file without a #columns header that names its Type column.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في السطر %1$lld النوع \"%2$@\"، وهو ليس من أنواعك، ولا ينشئ أنواعًا جديدة إلا ملف يسمي عمود Type في ترويسة ‎#columns."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %1$lld hat den Typ „%2$@“, der keiner deiner Typen ist, und nur eine Datei, die ihre Spalte Type in einer #columns-Kopfzeile benennt, erstellt neue Typen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Line %1$lld has the type “%2$@”, which isn't one of yours, and only a file that names its Type column in a #columns header makes new types."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea %1$lld tiene el tipo «%2$@», que no es uno de los tuyos, y solo un archivo que nombra su columna Type en un encabezado #columns crea tipos nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne %1$lld a le type « %2$@ », qui ne fait pas partie des vôtres, et seul un fichier qui nomme sa colonne Type dans un en-tête #columns crée de nouveaux types."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riga %1$lld ha il tipo “%2$@”, che non è tra i tuoi, e solo un file che nomina la sua colonna Type in un’intestazione #columns crea nuovi tipi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld行目のタイプ「%2$@」はまだありません。新しいタイプを作成できるのは、#columnsヘッダでType列を指定したファイルだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld번째 줄의 유형 ‘%2$@’은(는) 사용자의 유형이 아니며, #columns 헤더에 Type 열을 명시한 파일만 새 유형을 만들 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linha %1$lld tem o tipo “%2$@”, que não é um dos seus, e só um arquivo que nomeia sua coluna Type em um cabeçalho #columns cria tipos novos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В строке %1$lld указан тип «%2$@», которого у Вас нет, а новые типы создает только файл, в заголовке #columns которого названа колонка Type."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%1$lld行的类型“%2$@”不是你已有的类型，只有在#columns标题中指明Type列的文件才能创建新类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%1$lld行的類型為「%2$@」，這不是你的類型；只有在#columns標頭中指定Type欄的檔案才能建立新類型。"
          }
        }
      }
    },
    "Line %lld opens a quote that nothing closes." : {
      "comment" : "In the Import sheet, a line the file can't read.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
