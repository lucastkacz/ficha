    "Turning it on sends %@ of images and sounds to your iCloud." : {
      "comment" : "Settings, under Sync, while sync is off: what the images and sounds turning sync on sends weigh, said from 100 MB.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Aktivieren werden %@ an Bildern und Tönen in deine iCloud gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activarla envía %@ de imágenes y sonidos a tu iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activer envoie %@ d’images et de sons sur votre iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivandola, vengono inviati %@ di immagini e audio al tuo iCloud."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao ativá-la, %@ de imagens e sons são enviados para o seu iCloud."
          }
        }
      }
    },
    "Type" : {
