    "All cards" : {
      "comment" : "An item of the Cards window's sidebar: every card but the buried ones.\nThe name the Export sheet's save panel proposes for the file of all cards.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Karten"
