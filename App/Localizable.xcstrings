    "%lld cards have a side with only a sound the package lacks, as when Anki exports a deck without its media." : {
      "comment" : "In the Import sheet, the cards of an Anki package that make none, with how many.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Karte hat eine Seite mit nur einem Ton, der im Paket fehlt, etwa wenn Anki einen Stapel ohne seine Medien exportiert."
                }
              },
              "other" : {
