    "toolbar.back" : {
      "comment" : "A toolbar button of the Cards window, while it lists a tag's cards: back to All Tags.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Back"
