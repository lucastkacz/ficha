          }
        }
      }
    },
    "Its review log goes too, and you can't bring it back." : {
      "comment" : "Under the title of the Cards window's question before it deletes a card.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Wiederholungsverlauf wird ebenfalls gelöscht, und du kannst sie nicht zurückholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se va su historial de repasos, y no la podés recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son historique des révisions est aussi supprimé, et vous ne pourrez pas le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eliminata anche la sua cronologia dei ripassi, e non potrai recuperarla."
