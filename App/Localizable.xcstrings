{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%lld)" : {
      "comment" : "An item of the Export sheet's menu: the cards that live in a deck, or a deck inside it, with the deck's emoji, when it has one, and its whole name, like “🗣️ Idiomas › Inglés”, and how many.\nAn item of the Export sheet's menu: the cards with a tag, with the tag and how many.\nAn item of the “+N more” menu above the Cards window's card list: a tag of the deck the sidebar chose, with how many of its cards carry it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld)"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ can't open your cards" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede abrir tus tarjetas"
          }
        }
      }
    },
    "%@ can't open your cards. Open it to see why." : {
      "comment" : "An error from the app's Review Now action, when the app couldn't open its cards at launch. Opening the app again shows an alert that says why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede abrir tus tarjetas. Abrila para ver por qué."
          }
        }
      }
    },
    "%@ couldn't read these settings, as when they're edited by hand: %@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings." : {
      "comment" : "An alert at launch. The names are the settings' names in the app's preferences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't read these settings, as when they're edited by hand: %2$@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no pudo leer esta parte de su configuración, como pasa cuando se edita a mano: %2$@. Volvió a sus valores predeterminados, y el atajo de captura está desactivado, hasta que la vuelvas a definir en Configuración."
          }
        }
      }
    },
    "%@ couldn't turn on its capture shortcut" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo activar su atajo de captura"
          }
        }
      }
    },
    "%@ never does, so it doesn't get in the real Ficha's way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nunca lo hace, para no cruzarse con la Ficha de verdad."
          }
        }
      }
    },
    "%@ shows you cards only while it's open. You can change this later in Settings." : {
      "comment" : "An alert at the app's first launch, under whether it opens at login. The name is the app's.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ te muestra tarjetas solo mientras está abierta. Podés cambiarlo después en Configuración."
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "An appearance log entry in Diagnostics: when it showed, or was held back, and what opened the review panel.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@'s data was deleted from iCloud. Turning sync on sends all your cards again." : {
      "comment" : "Settings, under Sync, after the user deleted the app's data in iCloud's settings, which turned sync off. The name is the app's.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de %@ se eliminaron de iCloud. Al activar la sincronización se vuelven a enviar todas tus tarjetas."
          }
        }
      }
    },
    "%@'s data was deleted from iCloud. Turning sync on sends the cards in the decks you choose again." : {
      "comment" : "Settings, under Sync, after the user deleted the app's data in iCloud's settings, which turned sync off, while only the cards in ticked decks sync. The name is the app's.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de %@ se eliminaron de iCloud. Al activar la sincronización se vuelven a enviar las tarjetas de los mazos que elijas."
          }
        }
      }
    },
    "%@, %lld due" : {
      "comment" : "The menu-bar icon, with the due count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld due"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %#@due@"
          },
          "substitutions" : {
            "due" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pendientes"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pendiente"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pendientes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, back first" : {
      "comment" : "For VoiceOver, a point of the Cards window's chart: what Lucas answered, in a review that went back first, like “Good, back first”.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, reverso primero"
          }
        }
      }
    },
    "%@mo" : {
      "comment" : "An interval of this many months, a month counted as a twelfth of a year of 365 days, about 30.4 days, with a decimal, like “1.5mo”: short, as Anki's buttons show it, on the review panel's buttons and in the Cards window. Anki's own short unit in each language.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ me"
          }
        }
      }
    },
    "%@y" : {
      "comment" : "An interval of this many years, a year counted as 365 days, with a decimal, like “2.1y”: short, as Anki's buttons show it, on the review panel's buttons and in the Cards window. Anki's own short unit in each language.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ añ"
          }
        }
      }
    },
    "%lld cards are Image Occlusion cards, which hide parts of an image." : {
      "comment" : "In the Import sheet, the cards of an Anki package that make none, with how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld card is an Image Occlusion card, which hides parts of an image."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cards are Image Occlusion cards, which hide parts of an image."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas son de Oclusión de imagen, que ocultan partes de una imagen."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjeta es de Oclusión de imagen, que oculta partes de una imagen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tarjetas son de Oclusión de imagen, que ocultan partes de una imagen."
                }
              }
            }
          }
        }
      }
    },
    "%lld cards go too, with their review logs, here and on your other devices." : {
      "comment" : "In the Cards window's question before it deletes a deck: the cards in it and in the decks inside it, counted on this Mac.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "1 card goes too, with its review log, here and on your other devices."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld cards go too, with their review logs, here and on your other devices."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No card here goes with it."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se va una tarjeta, con su historial de repasos, acá y en tus otros dispositivos."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se van %lld tarjetas, con sus historiales de repasos, acá y en tus otros dispositivos."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "No se va ninguna tarjeta con él."
                }
              }
            }
          }
        }
      }
    },
    "%lld cards have a side with neither text, an image nor a sound once images on the web are left out." : {
