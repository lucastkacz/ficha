    "To undo it, restore the copy saved before it, in Settings › Backups." : {
      "comment" : "In the Import sheet once it's done, when Ficha saved a copy before the import.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتراجع عنه، استعد النسخة المحفوظة قبله، في الإعدادات › النسخ الاحتياطية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ihn rückgängig zu machen, stelle die davor gesicherte Kopie wieder her, in Einstellungen › Backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para deshacerla, restaurá la copia guardada antes, en Configuración › Respaldos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’annuler, restaurez la copie enregistrée juste avant, dans Réglages › Sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per annullarla, ripristina la copia salvata prima, in Impostazioni › Backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消すには、「設定」＞「バックアップ」で、読み込み前に保存されたコピーを復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 취소하려면 설정 › 백업에서 가져오기 전에 저장된 사본을 복원하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desfazer, restaure a cópia salva antes dela, em Ajustes › Backups."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отменить его, восстановите копию, сохраненную перед ним, в разделе «Настройки» › «Резервные копии»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要撤销，请在“设置”›“备份”中恢复导入前保存的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要撤銷匯入，請在「設定」›「備份」中回復匯入前儲存的副本。"
          }
        }
      }
    },
