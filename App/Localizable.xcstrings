    },
    "What do you want to know?" : {
      "comment" : "The prompt of the field where the user writes a question about the card the review panel shows.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du wissen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué querés saber?"
          }
        }
      }
    },
    "What needs fixing?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was muss korrigiert werden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué hay que corregir?"
          }
        }
      }
    },
    "What you capture, and the cards you flag, wait here to be refined." : {
      "comment" : "In the Cards window, when the inbox is empty.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du erfasst und die Karten, die du markierst, warten hier darauf, ausgearbeitet zu werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que capturás, y las tarjetas que marcás, esperan acá para refinarse."
          }
        }
      }
    },
    "When it shows up on its own. Opened with Review now, it takes the keyboard at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es von selbst erscheint. Mit „Jetzt wiederholen“ geöffnet, übernimmt es die Tastatur sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando aparece por su cuenta. Si lo abrís con Repasar ahora, toma el teclado enseguida."
          }
        }
      }
    },
    "With review now" : {
      "comment" : "In Diagnostics: Lucas opened the review panel with Review now, from the menu or the Shortcuts app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Jetzt wiederholen“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Repasar ahora"
          }
        }
      }
    },
    "Word" : {
      "comment" : "A card type.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wort"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabra"
          }
