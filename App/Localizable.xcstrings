    "%@ can't open your cards" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر على %@ فتح بطاقاتك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann deine Karten nicht öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede abrir tus tarjetas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ouvrir vos cartes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non riesce ad aprire le tue carte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はカードを開けません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 카드를 열 수 없음"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não consegue abrir seus cartões"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может открыть Ваши карточки"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@无法打开你的卡片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@無法打開你的卡片"
          }
        }
      }
    },
    "%@ can't open your cards. Open it to see why." : {
      "comment" : "An error from the app's Review Now action, when the app couldn't open its cards at launch. Opening the app again shows an alert that says why.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر على %@ فتح بطاقاتك. افتحه لمعرفة السبب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann deine Karten nicht öffnen. Öffne die App, um den Grund zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede abrir tus tarjetas. Abrila para ver por qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas ouvrir vos cartes. Ouvrez-la pour savoir pourquoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non riesce ad aprire le tue carte. Aprila per vedere perché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はカードを開けません。アプリを開いて理由を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 카드를 열 수 없습니다. 이유를 확인하려면 앱을 여십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não consegue abrir seus cartões. Abra o app para ver o motivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может открыть Ваши карточки. Откройте приложение, чтобы узнать причину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@无法打开你的卡片。请打开App查看原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@無法打開你的卡片。打開App來查看原因。"
          }
        }
      }
    },
    "%@ couldn't read these settings, as when they're edited by hand: %@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings." : {
      "comment" : "An alert at launch. The names are the settings' names in the app's preferences.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على %1$@ قراءة هذه الإعدادات، كما يحدث عند تعديلها يدويًا: %2$@. وقد عادت إلى قيمها الافتراضية، واختصار التدوين متوقف، إلى أن تضبطها مرة أخرى في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte diese Einstellungen nicht lesen, etwa weil sie von Hand bearbeitet wurden: %2$@. Sie stehen auf ihren Standardwerten, und ein Kurzbefehl zum Erfassen ist deaktiviert, bis du sie in den Einstellungen erneut festlegst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't read these settings, as when they're edited by hand: %2$@. They're at their defaults, and a capture shortcut is off, until you set them again in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no pudo leer esta parte de su configuración, como pasa cuando se edita a mano: %2$@. Volvió a sus valores predeterminados, y el atajo de captura está desactivado, hasta que la vuelvas a definir en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas pu lire ces réglages, comme lorsqu’ils sont modifiés à la main : %2$@. Ils sont revenus à leurs valeurs par défaut, et le raccourci de capture est désactivé, jusqu’à ce que vous les définissiez à nouveau dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non è riuscita a leggere queste impostazioni, come succede quando vengono modificate a mano: %2$@. Sono tornate ai valori predefiniti, e l’abbreviazione di cattura è disattivata, finché non le imposti di nuovo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は次の設定を読み込めませんでした（手作業で編集した場合などに起こります）: %2$@。「設定」でもう一度設定するまで、これらは初期設定のままで、メモのショートカットはオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 다음 설정을 읽을 수 없습니다: %2$@. 설정을 직접 편집한 경우 이런 일이 생길 수 있습니다. 설정에서 다시 지정할 때까지 기본값이 사용되며, 메모 단축키는 꺼져 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não conseguiu ler estes ajustes, como acontece quando são editados à mão: %2$@. Eles estão com os valores padrão, e o atalho de captura está desativado, até que você os defina de novo nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не удалось прочитать эти настройки (так бывает, если их изменить вручную): %2$@. Пока Вы не зададите их снова в настройках, у них значения по умолчанию, а сочетание клавиш для заметки выключено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@无法读取以下设置（例如手动编辑过时会出现这种情况）：%2$@。在“设置”中重新设定之前，这些设置将保持默认值，速记快捷键也会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@無法讀取這些設定（例如手動編輯過時會發生）：%2$@。在你於「設定」中重新設定之前，這些設定會維持預設值，且速記快速鍵會關閉。"
          }
        }
      }
    },
    "%@ couldn't turn on its capture shortcut" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على %@ تشغيل اختصار التدوين"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte den Kurzbefehl zum Erfassen nicht aktivieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo activar su atajo de captura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu activer son raccourci de capture"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è riuscita ad attivare l’abbreviazione di cattura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はメモのショートカットをオンにできませんでした"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 메모 단축키를 켤 수 없음"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não conseguiu ativar seu atalho de captura"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не удалось включить сочетание клавиш для заметки"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@无法打开速记快捷键"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@無法開啟速記快速鍵"
          }
        }
      }
    },
    "%@ never does, so it doesn't get in the real Ficha's way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يبدأ %@ عند الدخول أبدًا، كي لا يعترض طريق Ficha الحقيقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tut das nie, damit es dem echten Ficha nicht in die Quere kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nunca lo hace, para no cruzarse con la Ficha de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne le fait jamais, pour ne pas gêner la vraie Ficha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non lo fa mai, per non intralciare la vera Ficha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はログイン時に起動しないため、本物のFichaの邪魔になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 로그인 시 열리지 않으므로 실제 Ficha를 방해하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nunca faz isso, para não atrapalhar a verdadeira Ficha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ никогда этого не делает, чтобы не мешать настоящему приложению Ficha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@永远不会在登录时打开，因此不会妨碍正式版Ficha。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@永遠不會在登入時打開，因此不會妨礙真正的Ficha。"
          }
        }
      }
    },
    "%@ shows you cards only while it's open. You can change this later in Settings." : {
      "comment" : "An alert at the app's first launch, under whether it opens at login. The name is the app's.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرض لك %@ البطاقات إلا أثناء فتحه. يمكنك تغيير ذلك لاحقًا في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zeigt dir Karten nur, solange die App geöffnet ist. Du kannst das später in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ te muestra tarjetas solo mientras está abierta. Podés cambiarlo después en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne vous montre des cartes que lorsqu’elle est ouverte. Vous pourrez modifier ce choix plus tard dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ti mostra le carte solo mentre è aperta. Puoi cambiarlo più tardi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、開いているあいだだけカードを表示します。この設定はあとで「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 열려 있는 동안에만 카드를 보여 줍니다. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ só mostra cartões enquanto está aberta. Você pode mudar isso depois nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ показывает Вам карточки, только пока приложение открыто. Это можно изменить позже в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@只在打开时向你显示卡片。你可以稍后在“设置”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@只會在打開時為你顯示卡片。你之後可以在「設定」中更改此設定。"
          }
        }
      }
    },
