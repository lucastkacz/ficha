    "Next card on %@ at %@" : {
      "comment" : "In the widget: when the next card comes, another day. The day is a weekday or a date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Karte am %1$@ um %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Next card on %1$@ at %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próxima tarjeta el %1$@ a las %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prossima carta: %1$@ alle %2$@"
          }
        }
      }
    },
    "No card waiting" : {
      "comment" : "In the widget, when no card waits to be reviewed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Karte wartet"
          }
        },
        "es" : {
