          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正解"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо"
          }
        }
