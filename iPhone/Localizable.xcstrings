          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichaには「%@」という名前の画像も音声もありません。`ficha cards`が表示するとおりの名前か、Mac上のファイルのパスを指定してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
