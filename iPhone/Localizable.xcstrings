        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não tem imagem na frente, por isso não há nenhuma para tirar. `ficha cards` mostra a imagem e o som de cada lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На лице карточки %lld нет изображения, поэтому удалять нечего. `ficha cards` называет изображение и звук каждой стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的正面没有图片，因此无可移除。`ficha cards`会列出每一面的图片和声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的正面沒有影像，因此沒有可移除的影像。`ficha cards`會列出每一面的影像和聲音。"
          }
        }
      }
    },
    "Card %lld has no sound on its back, so there's none to take off. `ficha cards` names each side's image and sound." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد صوت على الجانب الخلفي للبطاقة %lld، لذا لا يوجد ما يُزال. يذكر `ficha cards` صورة كل جانب وصوته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld hat keinen Ton auf der Rückseite, daher gibt es keinen zu entfernen. `ficha cards` nennt Bild und Ton jeder Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld no tiene sonido en el reverso, así que no hay ninguno para quitar. `ficha cards` nombra la imagen y el sonido de cada lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld n’a pas de son au verso, donc il n’y en a aucun à retirer. `ficha cards` indique l’image et le son de chaque face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non ha nessun audio sul retro, quindi non c’è niente da togliere. `ficha cards` indica l’immagine e l’audio di ogni lato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldの裏面には音声がないため、削除するものはありません。`ficha cards`で各面の画像と音声の名前を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld의 뒷면에 사운드가 없으므로 제거할 사운드가 없습니다. `ficha cards`는 각 면의 이미지와 사운드 이름을 보여 줍니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não tem som no verso, por isso não há nenhum para tirar. `ficha cards` mostra a imagem e o som de cada lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На обороте карточки %lld нет звука, поэтому удалять нечего. `ficha cards` называет изображение и звук каждой стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的背面没有声音，因此无可移除。`ficha cards`会列出每一面的图片和声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的背面沒有聲音，因此沒有可移除的聲音。`ficha cards`會列出每一面的影像和聲音。"
          }
        }
      }
    },
    "Card %lld has no sound on its front, so there's none to take off. `ficha cards` names each side's image and sound." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد صوت على الجانب الأمامي للبطاقة %lld، لذا لا يوجد ما يُزال. يذكر `ficha cards` صورة كل جانب وصوته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld hat keinen Ton auf der Vorderseite, daher gibt es keinen zu entfernen. `ficha cards` nennt Bild und Ton jeder Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld no tiene sonido en el anverso, así que no hay ninguno para quitar. `ficha cards` nombra la imagen y el sonido de cada lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld n’a pas de son au recto, donc il n’y en a aucun à retirer. `ficha cards` indique l’image et le son de chaque face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non ha nessun audio sul fronte, quindi non c’è niente da togliere. `ficha cards` indica l’immagine e l’audio di ogni lato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldの表面には音声がないため、削除するものはありません。`ficha cards`で各面の画像と音声の名前を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld의 앞면에 사운드가 없으므로 제거할 사운드가 없습니다. `ficha cards`는 각 면의 이미지와 사운드 이름을 보여 줍니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não tem som na frente, por isso não há nenhum para tirar. `ficha cards` mostra a imagem e o som de cada lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На лице карточки %lld нет звука, поэтому удалять нечего. `ficha cards` называет изображение и звук каждой стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的正面没有声音，因此无可移除。`ficha cards`会列出每一面的图片和声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld的正面沒有聲音，因此沒有可移除的聲音。`ficha cards`會列出每一面的影像和聲音。"
          }
        }
      }
    },
    "Card %lld is buried. To bring it back, unbury it." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld مدفونة. لإرجاعها، قم بنكشها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld ist begraben. Um sie zurückzuholen, grabe sie aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld está enterrada. Para recuperarla, desenterrala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld est enfouie. Pour la faire revenir, déterrez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld è seppellita. Per recuperarla, disseppelliscila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldは除外されています。戻すには、除外を解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld은(는) 묻어 둔 상태입니다. 되돌리려면 다시 꺼내십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld está oculto. Para trazê-lo de volta, desoculte-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %lld отложена. Верните ее, чтобы она снова появлялась."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld已搁置。若要恢复，请取消搁置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld已埋藏。若要讓它回來，請取消埋藏。"
          }
        }
      }
    },
    "Card %lld is flagged: it waits in the inbox to be fixed. Close the review panel and open “Review now” again." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld مؤشَّرة: تنتظر في صندوق الوارد ليتم إصلاحها. أغلق لوحة المراجعة وافتح \"المراجعة الآن\" مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld ist markiert: Sie wartet im Eingang darauf, korrigiert zu werden. Schließe das Wiederholungsfenster und öffne „Jetzt wiederholen“ erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld está marcada: espera en la bandeja a que se corrija. Cerrá el panel de repaso y volvé a abrir «Repasar ahora»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld est marquée : elle attend dans la boîte de réception d’être corrigée. Fermez le panneau de révision et ouvrez à nouveau « Réviser maintenant »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld è contrassegnata: attende nella casella in entrata di essere corretta. Chiudi il pannello di ripasso e apri di nuovo “Ripassa ora”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldにはフラグが付いていて、修正されるまでインボックスで待っています。復習パネルを閉じて、「今すぐ復習」をもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld에 깃발 표시가 되어 있습니다. 수정될 때까지 수신함에서 기다립니다. 복습 패널을 닫고 ‘지금 복습’을 다시 여십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld está sinalizado: ele espera na caixa de entrada para ser corrigido. Feche o painel de revisão e abra “Revisar agora” de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %lld помечена: она ждет исправления во входящих. Закройте панель повторения и снова откройте «Повторить сейчас»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld带有旗标：它正在收件箱中等待修正。请关闭复习面板，然后重新打开“立即复习”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld已加上旗標：它正在收件匣中等待修正。請關閉複習面板，然後再次打開「立即複習」。"
          }
        }
      }
    },
    "Card %lld is set aside with the deck “%@”. To bring it back, untick Set Aside on that deck in the Cards window." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %1$lld موضوعة جانبًا مع الرزمة \"%2$@\". لإرجاعها، ألغِ تحديد \"وضع جانبًا\" في تلك الرزمة في نافذة البطاقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %1$lld ist mit dem Stapel „%2$@“ zurückgestellt. Um sie zurückzuholen, entferne im Fenster „Karten“ bei diesem Stapel das Häkchen bei „Zurückstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %1$lld está apartada con el mazo «%2$@». Para recuperarla, destildá Apartar en ese mazo, en la ventana Tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %1$lld est mise de côté avec le paquet « %2$@ ». Pour la faire revenir, décochez Mettre de côté sur ce paquet dans la fenêtre Cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %1$lld è accantonata con il mazzo “%2$@”. Per recuperarla, togli la spunta ad Accantona su quel mazzo, nella finestra Carte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%1$lldはデッキ「%2$@」とともに保留中です。戻すには、「カード」ウインドウでそのデッキの「保留」のチェックを外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %1$lld은(는) ‘%2$@’ 덱과 함께 제쳐 둔 상태입니다. 되돌리려면 카드 윈도우에서 해당 덱의 ‘제쳐 두기’를 선택 해제하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %1$lld está posto de lado com o baralho “%2$@”. Para trazê-lo de volta, desmarque Pôr de Lado nesse baralho, na janela Cartões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %1$lld приостановлена вместе с колодой «%2$@». Чтобы вернуть ее, снимите флажок «Приостановить» у этой колоды в окне «Карточки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%1$lld随牌组“%2$@”一起暂缓。若要恢复，请在卡片窗口中取消勾选该牌组的“暂缓”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%1$lld已隨牌組「%2$@」放在一旁。若要讓它回來，請在「卡片」視窗中取消勾選該牌組的「放在一旁」。"
          }
        }
      }
    },
    "Card %lld is set aside with the decks %@. To bring it back, untick Set Aside on each of them in the Cards window." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %1$lld موضوعة جانبًا مع الرزم %2$@. لإرجاعها، ألغِ تحديد \"وضع جانبًا\" في كل منها في نافذة البطاقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %1$lld ist mit den Stapeln %2$@ zurückgestellt. Um sie zurückzuholen, entferne im Fenster „Karten“ bei jedem davon das Häkchen bei „Zurückstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %1$lld está apartada con los mazos %2$@. Para recuperarla, destildá Apartar en cada uno de ellos, en la ventana Tarjetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %1$lld est mise de côté avec les paquets %2$@. Pour la faire revenir, décochez Mettre de côté sur chacun d’eux dans la fenêtre Cartes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %1$lld è accantonata con i mazzi %2$@. Per recuperarla, togli la spunta ad Accantona su ciascuno di essi, nella finestra Carte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%1$lldはデッキ%2$@とともに保留中です。戻すには、「カード」ウインドウでそれぞれのデッキの「保留」のチェックを外してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %1$lld은(는) %2$@ 덱과 함께 제쳐 둔 상태입니다. 되돌리려면 카드 윈도우에서 각 덱의 ‘제쳐 두기’를 선택 해제하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %1$lld está posto de lado com os baralhos %2$@. Para trazê-lo de volta, desmarque Pôr de Lado em cada um deles, na janela Cartões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %1$lld приостановлена вместе с колодами %2$@. Чтобы вернуть ее, снимите флажок «Приостановить» у каждой из них в окне «Карточки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%1$lld随牌组%2$@一起暂缓。若要恢复，请在卡片窗口中逐一取消勾选这些牌组的“暂缓”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%1$lld已隨牌組%2$@放在一旁。若要讓它回來，請在「卡片」視窗中取消勾選每個牌組的「放在一旁」。"
          }
        }
      }
    },
    "Card %lld isn't buried, so there's nothing to unbury. Check the card's id." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld ليست مدفونة، لذا لا يوجد ما يُنكش. تحقق من معرّف البطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld ist nicht begraben, daher gibt es nichts auszugraben. Prüfe die ID der Karte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld no está enterrada, así que no hay nada que desenterrar. Revisá el id de la tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld n’est pas enfouie, donc il n’y a rien à déterrer. Vérifiez l’identifiant de la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non è seppellita, quindi non c’è niente da disseppellire. Controlla l’id della carta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldは除外されていないため、解除するものはありません。カードのIDを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld은(는) 묻어 둔 상태가 아니므로 다시 꺼낼 것이 없습니다. 카드 ID를 확인하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não está oculto, por isso não há nada para desocultar. Verifique o id do cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %lld не отложена, поэтому возвращать нечего. Проверьте ID карточки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld未被搁置，因此无需取消搁置。请检查卡片的ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld未被埋藏，因此無須取消埋藏。請檢查卡片的ID。"
          }
        }
      }
    },
    "Card %lld isn't due yet, so it can't be reviewed. Close the review panel and open “Review now” again." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld ليست مستحقة بعد، لذا لا يمكن مراجعتها. أغلق لوحة المراجعة وافتح \"المراجعة الآن\" مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld ist noch nicht fällig und kann daher nicht wiederholt werden. Schließe das Wiederholungsfenster und öffne „Jetzt wiederholen“ erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld todavía no está pendiente, así que no se puede repasar. Cerrá el panel de repaso y volvé a abrir «Repasar ahora»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld n’est pas encore à réviser, donc elle ne peut pas être révisée. Fermez le panneau de révision et ouvrez à nouveau « Réviser maintenant »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non è ancora in scadenza, quindi non può essere ripassata. Chiudi il pannello di ripasso e apri di nuovo “Ripassa ora”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldはまだ期日を迎えていないため、復習できません。復習パネルを閉じて、「今すぐ復習」をもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld은(는) 아직 만기가 아니므로 복습할 수 없습니다. 복습 패널을 닫고 ‘지금 복습’을 다시 여십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld ainda não está na data de revisão, por isso não pode ser revisado. Feche o painel de revisão e abra “Revisar agora” de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок повторения карточки %lld еще не наступил, поэтому ее нельзя повторить. Закройте панель повторения и снова откройте «Повторить сейчас»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld尚未到期，因此无法复习。请关闭复习面板，然后重新打开“立即复习”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld尚未到期，因此無法複習。請關閉複習面板，然後再次打開「立即複習」。"
          }
        }
      }
    },
    "Card %lld isn't flagged, so there's nothing to fix: it was already fixed, or it was never flagged. Check what's in the inbox." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld ليست مؤشَّرة، لذا لا يوجد ما يُصلح: فقد أُصلحت بالفعل، أو لم تُؤشَّر أبدًا. تحقق مما في صندوق الوارد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld ist nicht markiert, daher gibt es nichts zu korrigieren: Sie wurde schon korrigiert oder nie markiert. Prüfe, was im Eingang ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld no está marcada, así que no hay nada que corregir: ya se corrigió, o nunca se marcó. Revisá qué hay en la bandeja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld n’est pas marquée, donc il n’y a rien à corriger : elle a déjà été corrigée, ou elle n’a jamais été marquée. Vérifiez le contenu de la boîte de réception."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non è contrassegnata, quindi non c’è niente da correggere: è già stata corretta, oppure non è mai stata contrassegnata. Controlla cosa c’è nella casella in entrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldにはフラグが付いていないため、修正するものはありません。すでに修正されたか、フラグが付いたことがありません。インボックスの内容を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld에 깃발 표시가 없으므로 수정할 것이 없습니다. 이미 수정되었거나 깃발 표시된 적이 없습니다. 수신함의 내용을 확인하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não está sinalizado, por isso não há nada para corrigir: ele já foi corrigido, ou nunca foi sinalizado. Verifique o que há na caixa de entrada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка %lld не помечена, поэтому исправлять нечего: ее уже исправили или никогда не помечали. Проверьте, что есть во входящих."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld没有旗标，因此无需修正：它已被修正，或从未加过旗标。请检查收件箱中的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld未加上旗標，因此無須修正：它已修正過，或從未加上旗標。請檢查收件匣中的內容。"
          }
        }
      }
    },
    "Card %lld isn't one of the cards its appearance brought, so its answer wasn't recorded. Report it." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطاقة %lld ليست من البطاقات التي جلبها ظهورها، لذا لم تُسجَّل إجابتها. أبلغ عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte %lld gehört nicht zu den Karten ihrer Einblendung, daher wurde ihre Antwort nicht aufgezeichnet. Melde es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta %lld no es una de las que trajo su aparición, así que su respuesta no se guardó. Reportalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte %lld ne fait pas partie des cartes de son apparition, donc sa réponse n’a pas été enregistrée. Signalez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta %lld non è tra le carte portate dalla sua apparizione, quindi la sua risposta non è stata registrata. Segnalalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード%lldはこの出現で出されたカードではないため、回答は記録されませんでした。報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 %lld은(는) 이번 등장에서 가져온 카드가 아니므로 답변이 기록되지 않았습니다. 이 문제를 보고하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão %lld não é um dos cartões que sua aparição trouxe, por isso a resposta não foi salva. Relate o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточки %lld не было среди карточек ее появления, поэтому ответ на нее не записан. Сообщите об ошибке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld不在此次出现带来的卡片中，因此未记录其回答。请报告此问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片%lld不在此次出現帶來的卡片之中，因此未記錄其回答。請回報此問題。"
          }
        }
      }
    },
    "Card [%lld] has a blank front or back: give each side text, an image or a sound." : {
      "comment" : "A message of an error of Ficha's engine, EngineError, which the iPhone app shows. Added by hand, since Xcode doesn't extract FichaKit's texts: EngineMessagesTests checks every message is here.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للبطاقة [%lld] جانب أمامي أو خلفي فارغ: أعطِ كل جانب نصًا أو صورة أو صوتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte [%lld] hat eine leere Vorder- oder Rückseite: Gib jeder Seite einen Text, ein Bild oder einen Ton."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta [%lld] tiene el anverso o el reverso en blanco: dale a cada lado un texto, una imagen o un sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte [%lld] a un recto ou un verso vide : donnez à chaque face un texte, une image ou un son."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carta [%lld] ha il fronte o il retro vuoto: dai a ogni lato un testo, un’immagine o un audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード[%lld]の表面または裏面が空です。各面にテキスト、画像、音声のいずれかを入れてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 [%lld]의 앞면 또는 뒷면이 비어 있습니다. 각 면에 텍스트, 이미지 또는 사운드를 넣으십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão [%lld] tem a frente ou o verso em branco: dê a cada lado um texto, uma imagem ou um som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У карточки [%lld] пустое лицо или оборот: добавьте на каждую сторону текст, изображение или звук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片[%lld]的正面或背面为空：请为每一面添加文本、图片或声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片[%lld]的正面或背面為空白：請為每一面加入文字、影像或聲音。"
          }
        }
      }
    },
