          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichaは「ダウンロード」フォルダのファイルだけを読み込みますが、「%@」はそこにありません。ファイルを「ダウンロード」にコピーして、そこでのパスを指定してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
